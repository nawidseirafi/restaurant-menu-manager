<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>{{ settings.restaurant_name }} Speisekarte</title>
<style>
@page cover { size:A4 portrait; margin:0; }
@page menu { size:A4 portrait; margin:11mm 11mm 12mm; background:#11100e; }
@page outro { size:A4 portrait; margin:0; }
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:#11100e;color:#f3ead7;-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{font-family:"Avenir Next","Segoe UI",Arial,sans-serif;font-size:8.4pt;line-height:1.22}

/* ---------- COVER ---------- */
.cover{page:cover;width:210mm;height:297mm;position:relative;overflow:hidden;background:#0e0d0b;color:#efe1bf}
.cover:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 17% 12%,rgba(180,48,29,.18),transparent 27%),radial-gradient(circle at 84% 48%,rgba(146,160,47,.08),transparent 28%),repeating-linear-gradient(0deg,rgba(255,255,255,.012) 0,rgba(255,255,255,.012) 1px,transparent 1px,transparent 4px);z-index:0}
.cover-inner{position:absolute;inset:7mm 7mm 14mm;border:.3mm solid rgba(230,212,172,.34);padding:10mm 9mm 0;z-index:2}
.cover-inner:after{content:"";position:absolute;inset:2.2mm;border:.16mm solid rgba(176,43,31,.5);pointer-events:none}
.cover-ornament{height:7mm;border-top:.85mm solid #a92c23;border-bottom:.35mm solid #d17a26;position:relative;margin-bottom:6mm}
.cover-ornament:after{content:"◆  ◆  ◆  ◆  ◆  ◆  ◆";position:absolute;left:0;right:0;top:-2.45mm;text-align:center;color:#c83426;font-size:7.5pt;letter-spacing:4mm}
.cover-brand{font-family:Impact,"Arial Narrow",sans-serif;font-weight:900;font-size:64pt;line-height:.86;letter-spacing:.012em;text-transform:uppercase;margin:0;color:#ebdbb9;text-shadow:0 1mm 0 rgba(0,0,0,.48)}
.cover-brand b{color:#c82f25}.cover-tag{margin-top:4mm;color:#a8b83b;font-size:12.5pt;font-weight:900;letter-spacing:.16em;text-transform:uppercase}
.cover-rule{margin-top:5mm;border-top:.7mm solid #a92c23;border-bottom:.2mm solid #d27e2d;height:2.6mm}
.cover-slogan{position:absolute;left:19mm;top:80mm;z-index:5;font-family:Impact,"Arial Narrow",sans-serif;color:#df8428;font-size:35pt;line-height:1.01;letter-spacing:.035em;text-transform:uppercase;margin:0;max-width:102mm;transform:rotate(-1deg);text-shadow:0 1mm 3mm rgba(0,0,0,.5)}
.cover-slogan:after{content:"";display:block;width:39mm;border-bottom:1mm solid #b82b22;margin:4mm 0 0 11mm;transform:rotate(-2deg)}
.cover-cactus{position:absolute;right:16mm;top:91mm;width:42mm;height:78mm;object-fit:cover;object-position:center;border-radius:1.5mm;filter:saturate(.92) contrast(1.08);box-shadow:0 4mm 12mm rgba(0,0,0,.52);z-index:3}
.cover-food{position:absolute;left:0;right:0;bottom:0;width:100%;height:118mm;object-fit:cover;object-position:center 52%;z-index:1;filter:saturate(.98) contrast(1.05)}
.cover-food-overlay{position:absolute;left:0;right:0;bottom:0;height:130mm;z-index:2;background:linear-gradient(180deg,#0e0d0b 0%,rgba(14,13,11,.88) 10%,rgba(14,13,11,.22) 38%,rgba(14,13,11,.06) 72%,rgba(14,13,11,.22) 100%);pointer-events:none}
.cover-card{position:absolute;right:17mm;top:168mm;width:56mm;min-height:59mm;padding:7mm 5.5mm 15mm;background:#d8b678;color:#2b2017;transform:rotate(-1.3deg);box-shadow:0 3mm 10mm rgba(0,0,0,.48);font-family:"Arial Narrow",Arial,sans-serif;text-align:center;z-index:6}
.cover-card strong{display:block;font-family:Impact,"Arial Narrow",sans-serif;font-size:16pt;line-height:1.03;letter-spacing:.025em;text-transform:uppercase;margin-bottom:3.5mm}.cover-card span{font-size:8pt;line-height:1.35;font-weight:700}
.cover-qr{position:absolute;right:25mm;top:217mm;z-index:8;width:28mm;padding:2.6mm;background:#ead9b5;color:#1b1712;text-align:center;box-shadow:0 2mm 7mm rgba(0,0,0,.5);transform:rotate(.6deg)}.cover-qr img{display:block;width:22.8mm;height:22.8mm;margin:0 auto 1.2mm;background:#fff}.cover-qr strong{font-family:Impact,"Arial Narrow",sans-serif;font-size:6.8pt;letter-spacing:.05em;text-transform:uppercase}
.cover-footer{position:absolute;left:7mm;right:7mm;bottom:0;height:14mm;background:#a92c23;display:flex;align-items:center;justify-content:center;gap:11mm;color:#ead9b5;font-weight:800;font-size:9pt;letter-spacing:.045em;z-index:10}
.cover-social{display:flex;gap:3.2mm;font-size:11pt;align-items:center}.social-icon{width:6.5mm;height:6.5mm;border:.4mm solid #e6c36c;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;color:#e6c36c;font-family:Arial,sans-serif;font-weight:900;font-size:7.5pt}.social-icon.ig{font-size:10pt}
.menu-pages{page:menu;background:#11100e;color:#f3ead7}.menu-pages.drinks-start,.menu-pages.cocktails-start{break-before:page}
.menu-pages:before{content:"";position:fixed;z-index:-5;inset:-7mm;border:.35mm solid rgba(232,213,174,.34);box-shadow:inset 0 0 0 .25mm rgba(176,43,31,.34);pointer-events:none}
.menu-topline{display:flex;align-items:center;justify-content:space-between;gap:8mm;margin:0 0 5.5mm;padding:0 0 3.5mm;border-bottom:.35mm solid #a82c23;break-after:avoid}
.brand{font-family:Impact,"Arial Narrow",sans-serif;font-size:24pt;font-weight:900;letter-spacing:.025em;line-height:.86;color:#eadbbd}.brand b{color:#c93226}.tagline{margin-top:1.6mm;color:#9aad38;font-size:8.2pt;font-weight:900;letter-spacing:.14em;text-transform:uppercase}.web{color:#d6b35c;font-weight:800;font-size:8pt;text-align:right}.web small{display:block;color:#8e8980;font-weight:600;margin-top:.7mm}
.menu-flow{columns:2;column-gap:9mm;column-rule:.2mm solid rgba(222,197,145,.12);column-fill:auto}
.section-label{break-inside:avoid;break-after:avoid;margin:1mm 0 4mm;padding:2.4mm 3mm 2.2mm;background:#3a1c12;border-left:1.2mm solid #c93226;border-top:.2mm solid rgba(222,197,145,.24);border-bottom:.2mm solid rgba(222,197,145,.24);color:#e8d4ae;font-family:Impact,"Arial Narrow",sans-serif;font-size:13.5pt;letter-spacing:.07em;text-transform:uppercase}
.category{margin:0 0 5.2mm;break-inside:auto}.category-heading{break-after:avoid;margin:0 0 1.6mm;padding:0 0 1.5mm;border-bottom:.25mm dotted rgba(213,172,78,.55)}
.category h2{margin:0;color:#a6b83d;font-family:Impact,"Arial Narrow",sans-serif;font-size:16.2pt;line-height:1;letter-spacing:.035em;text-transform:uppercase;text-shadow:0 .2mm 0 rgba(0,0,0,.4)}
.category[data-accent="1"] h2{color:#df8626}.category[data-accent="2"] h2{color:#d64262}.category[data-accent="3"] h2{color:#42a6a5}.category-description{margin:.9mm 0 0;color:#aaa397;font-size:7.3pt;line-height:1.2}
.menu-item{break-inside:avoid;padding:1.35mm 0 1.25mm;border-bottom:.18mm solid rgba(239,226,200,.12)}.item-line{display:flex;align-items:baseline;gap:1.6mm}.item-name{min-width:0;color:#f3ead7;font-weight:800;font-size:9.1pt;line-height:1.08}.leader{flex:1 1 auto;min-width:3mm;border-bottom:.2mm dotted rgba(215,168,74,.38);transform:translateY(-.7mm)}.price{flex:0 0 auto;white-space:nowrap;color:#f1dfbd;font-weight:900;font-size:8.9pt}.description{margin:.55mm 0 0;color:#a9a39a;font-size:7.15pt;line-height:1.22}.variant{display:flex;justify-content:space-between;gap:2mm;margin-top:.55mm;color:#c4bcae;font-size:7.1pt;font-weight:700}.variant strong{color:#e3bb62;white-space:nowrap}.meta{margin-top:.55mm;color:#d3a642;font-size:6.4pt;font-weight:900;letter-spacing:.035em;text-transform:uppercase}.dense{margin-bottom:4.1mm}.dense .menu-item{padding:.9mm 0}.dense .item-name,.dense .price{font-size:8.15pt}.dense .description,.dense .variant{font-size:6.6pt}.dense .category-heading{margin-bottom:1.15mm}.menu-photo{break-inside:avoid;margin:3mm 0 5mm;height:48mm;overflow:hidden;border:.25mm solid rgba(231,210,170,.26);box-shadow:0 2mm 7mm rgba(0,0,0,.42);position:relative}.menu-photo img{width:100%;height:100%;object-fit:cover;display:block;filter:saturate(.95) contrast(1.04)}.menu-photo:after{content:"";position:absolute;inset:0;box-shadow:inset 0 0 8mm rgba(0,0,0,.2);pointer-events:none}.menu-photo.tall{height:57mm}.end-mark{column-span:all;break-inside:avoid;margin-top:4mm;padding:3mm 0 0;border-top:.35mm solid #a82c23;text-align:center;color:#d6b35c;font-family:Impact,"Arial Narrow",sans-serif;font-size:10pt;letter-spacing:.13em;text-transform:uppercase}

/* ---------- OUTRO / QR ---------- */
.outro{page:outro;width:210mm;height:297mm;position:relative;overflow:hidden;background:#11100e;color:#f3ead7;padding:12mm 12mm 0}
.outro:before{content:"";position:absolute;inset:8mm;border:.35mm solid rgba(232,213,174,.38);box-shadow:inset 0 0 0 .22mm rgba(176,43,31,.42);pointer-events:none}
.outro-head{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-end;border-bottom:.55mm solid #a82c23;padding:3mm 3mm 5mm;margin:0 3mm 8mm}.outro-title{font-family:Impact,"Arial Narrow",sans-serif;font-size:29pt;letter-spacing:.05em;text-transform:uppercase;color:#e5d5b4}.outro-title b{color:#c93226}.outro-kicker{color:#9eaf39;font-weight:900;letter-spacing:.12em;text-transform:uppercase;font-size:8.5pt;text-align:right}
.food-strip{position:relative;z-index:2;display:grid;grid-template-columns:1.05fr 1fr 1fr;gap:4mm;margin:0 3mm 9mm;height:78mm}.food-strip img{width:100%;height:100%;object-fit:cover;border:.25mm solid rgba(231,210,170,.28);box-shadow:0 2mm 8mm rgba(0,0,0,.45)}
.cta{position:relative;z-index:2;display:grid;grid-template-columns:1fr 58mm;gap:9mm;margin:0 9mm;align-items:center}.cta-copy h2{font-family:Impact,"Arial Narrow",sans-serif;margin:0 0 4mm;color:#df8626;font-size:24pt;line-height:1.02;letter-spacing:.04em;text-transform:uppercase}.cta-copy p{margin:0 0 4mm;color:#bdb4a5;font-size:9pt;line-height:1.45}.cta-url{color:#e6c36c;font-weight:900;font-size:10.5pt;margin-top:5mm}.qr-card{background:#e8d7ae;color:#1b1712;padding:5mm;text-align:center;transform:rotate(.5deg);box-shadow:0 3mm 12mm rgba(0,0,0,.5)}.qr-card img{display:block;width:46mm;height:46mm;margin:0 auto 3mm;background:white}.qr-card strong{font-family:Impact,"Arial Narrow",sans-serif;font-size:11pt;letter-spacing:.05em;text-transform:uppercase}.outro-social{position:absolute;z-index:3;left:12mm;right:12mm;bottom:0;height:22mm;background:#a92c23;display:flex;align-items:center;justify-content:center;gap:9mm;color:#ead9b5}.outro-social .social-icon{width:9mm;height:9mm;font-size:9pt}.outro-social .social-icon.ig{font-size:13pt}.outro-social strong{font-size:9.5pt;letter-spacing:.04em}.outro-cactus{position:absolute;z-index:2;left:17mm;bottom:22mm;width:31mm;height:34mm;object-fit:cover;border-radius:2mm;box-shadow:0 2mm 8mm rgba(0,0,0,.5)}
</style>
</head>
<body>

<section class="cover">
  <div class="cover-inner">
    <div class="cover-ornament"></div>
    <h1 class="cover-brand">TACO<b>MEX</b></h1>
    <div class="cover-tag">Cocina ✦ Bar ✦ Cocktailgarten</div>
    <div class="cover-rule"></div>
    <div class="cover-slogan">Sabor, Pasión<br>y Fiesta!</div>
    {% if asset_data('cover_cactus.jpg') %}<img class="cover-cactus" src="{{ asset_data('cover_cactus.jpg') }}" alt="">{% endif %}
    <div class="cover-card"><strong>Hausgemacht.<br>Frisch.<br>Authentisch.</strong><span>Mexikanische Küche, gute Drinks und ganz viel TacoMex-Gefühl.</span></div>
    {% if asset_data('cover_food.jpg') %}<img class="cover-food" src="{{ asset_data('cover_food.jpg') }}" alt=""><div class="cover-food-overlay"></div>{% endif %}
    {% if qr_data_uri %}<div class="cover-qr"><img src="{{ qr_data_uri }}" alt="QR-Code"><strong>Menü online</strong></div>{% endif %}
  </div>
  <div class="cover-footer"><span>{{ settings.website_url or 'https://www.tacomex.de' }}</span><span class="cover-social"><span class="social-icon">f</span><span>Facebook</span><span class="social-icon ig">◎</span><span>Instagram</span></span></div>
</section>

<section class="menu-pages food-menu">
<header class="menu-topline">
  <div><div class="brand">TACO<b>MEX</b></div><div class="tagline">Cocina · Bar · Cocktailgarten</div></div>
</header>
<main class="menu-flow">
<div class="section-label">Essen</div>
{% set ns = namespace(accent=0) %}
{% for category in categories %}
  {% if category.type.value not in ['drinks','cocktails'] %}
    {% set ns.accent = (ns.accent + 1) % 4 %}
    <section class="category" data-accent="{{ ns.accent }}">
      <div class="category-heading"><h2>{{ category.name }}</h2>{% if category.description %}<p class="category-description">{{ category.description }}</p>{% endif %}</div>
      {% for item in category.items %}
      <article class="menu-item">
        <div class="item-line"><span class="item-name">{{ item.name }}</span><span class="leader"></span><span class="price">{{ format_price(item.price) }}</span></div>
        {% if item.description %}<p class="description">{{ item.description }}</p>{% endif %}
        {% if item.second_price %}<div class="variant"><span>{{ item.second_price_label or "Weitere Größe" }}</span><strong>{{ format_price(item.second_price) }}</strong></div>{% endif %}
        {% if item.allergens or item.additives or item.vegan or item.vegetarian or item.spicy_level %}<div class="meta">{% if item.vegan %}Vegan{% elif item.vegetarian %}Vegetarisch{% endif %}{% if item.spicy_level %}{% if item.vegan or item.vegetarian %} · {% endif %}Pikant {{ item.spicy_level }}{% endif %}{% if item.allergens %} · Allergene: {{ item.allergens }}{% endif %}{% if item.additives %} · Zusatzstoffe: {{ item.additives }}{% endif %}</div>{% endif %}
      </article>
      {% endfor %}
    </section>
    {% set cname = category.name|lower %}
    {% if 'nachos' in cname and asset_data('nachos.jpg') %}
      <figure class="menu-photo"><img src="{{ asset_data('nachos.jpg') }}" alt=""></figure>
    {% elif 'burrito' in cname and asset_data('burrito.jpg') %}
      <figure class="menu-photo tall"><img src="{{ asset_data('burrito.jpg') }}" alt=""></figure>
    {% elif 'fajita' in cname and asset_data('fajitas.jpg') %}
      <figure class="menu-photo"><img src="{{ asset_data('fajitas.jpg') }}" alt=""></figure>
    {% elif 'burger' in cname and asset_data('burger.jpg') %}
      <figure class="menu-photo tall"><img src="{{ asset_data('burger.jpg') }}" alt=""></figure>
    {% endif %}
  {% endif %}
{% endfor %}
</main>
</section>

<!-- Getränke beginnen bewusst auf einer neuen A4-Seite. -->
<section class="menu-pages drinks-start">
<header class="menu-topline">
  <div><div class="brand">TACO<b>MEX</b></div><div class="tagline">Cocina · Bar · Cocktailgarten</div></div>
</header>
<main class="menu-flow">
<div class="section-label">Getränke</div>
{% set ns = namespace(accent=2) %}
{% for category in categories %}
  {% if category.type.value == 'drinks' %}
    {% set ns.accent = (ns.accent + 1) % 4 %}
    <section class="category dense" data-accent="{{ ns.accent }}">
      <div class="category-heading"><h2>{{ category.name }}</h2>{% if category.description %}<p class="category-description">{{ category.description }}</p>{% endif %}</div>
      {% for item in category.items %}
      <article class="menu-item">
        <div class="item-line"><span class="item-name">{{ item.name }}</span><span class="leader"></span><span class="price">{{ format_price(item.price) }}</span></div>
        {% if item.description %}<p class="description">{{ item.description }}</p>{% endif %}
        {% if item.second_price %}<div class="variant"><span>{{ item.second_price_label or "Weitere Größe" }}</span><strong>{{ format_price(item.second_price) }}</strong></div>{% endif %}
        {% if item.allergens or item.additives or item.vegan or item.vegetarian or item.spicy_level %}<div class="meta">{% if item.vegan %}Vegan{% elif item.vegetarian %}Vegetarisch{% endif %}{% if item.spicy_level %}{% if item.vegan or item.vegetarian %} · {% endif %}Pikant {{ item.spicy_level }}{% endif %}{% if item.allergens %} · Allergene: {{ item.allergens }}{% endif %}{% if item.additives %} · Zusatzstoffe: {{ item.additives }}{% endif %}</div>{% endif %}
      </article>
      {% endfor %}
    </section>
  {% endif %}
{% endfor %}
</main>
</section>

<!-- Cocktails sind ein eigener Hauptbereich und beginnen ebenfalls auf einer neuen A4-Seite. -->
<section class="menu-pages cocktails-start">
<header class="menu-topline">
  <div><div class="brand">TACO<b>MEX</b></div><div class="tagline">Cocina · Bar · Cocktailgarten</div></div>
</header>
<main class="menu-flow">
<div class="section-label">Cocktails</div>
{% set ns = namespace(accent=1) %}
{% for category in categories %}
  {% if category.type.value == 'cocktails' %}
    {% set ns.accent = (ns.accent + 1) % 4 %}
    <section class="category dense" data-accent="{{ ns.accent }}">
      <div class="category-heading"><h2>{{ category.name }}</h2>{% if category.description %}<p class="category-description">{{ category.description }}</p>{% endif %}</div>
      {% for item in category.items %}
      <article class="menu-item">
        <div class="item-line"><span class="item-name">{{ item.name }}</span><span class="leader"></span><span class="price">{{ format_price(item.price) }}</span></div>
        {% if item.description %}<p class="description">{{ item.description }}</p>{% endif %}
        {% if item.second_price %}<div class="variant"><span>{{ item.second_price_label or "Weitere Größe" }}</span><strong>{{ format_price(item.second_price) }}</strong></div>{% endif %}
        {% if item.allergens or item.additives or item.vegan or item.vegetarian or item.spicy_level %}<div class="meta">{% if item.vegan %}Vegan{% elif item.vegetarian %}Vegetarisch{% endif %}{% if item.spicy_level %}{% if item.vegan or item.vegetarian %} · {% endif %}Pikant {{ item.spicy_level }}{% endif %}{% if item.allergens %} · Allergene: {{ item.allergens }}{% endif %}{% if item.additives %} · Zusatzstoffe: {{ item.additives }}{% endif %}</div>{% endif %}
      </article>
      {% endfor %}
    </section>
  {% endif %}
{% endfor %}
<div class="end-mark">¡Buen provecho! · Sabor, Pasión y Fiesta</div>
</main>
</section>

</body>
</html>
