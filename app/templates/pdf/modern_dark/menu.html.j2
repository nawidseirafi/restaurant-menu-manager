<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>{{ settings.restaurant_name }} Speisekarte</title>
<style>
@page cover { size:A4 portrait; margin:0; }
@page wood { size:A4 portrait; margin:0; background:#dcc6ad url("{{ asset_data('Holz-Hintergrund.png') }}") center/cover no-repeat; }
@page cocktail-one { size:A4 portrait; margin:0; background:#dcc6ad url("{{ asset_data('Cocktail-1.png') }}") center/cover no-repeat; }
@page cocktail-two { size:A4 portrait; margin:0; background:#dcc6ad url("{{ asset_data('Cocktail-2.png') }}") center/cover no-repeat; }
*{box-sizing:border-box}
html,body{margin:0;padding:0;-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{font-family:Arial,Helvetica,sans-serif;color:#17120f;font-size:8.6pt;line-height:1.16}
.cover{page:cover;width:210mm;height:297mm;overflow:hidden;position:relative;background:#dcc6ad}
.cover img{width:100%;height:100%;object-fit:cover;display:block}
.menu-page{page:wood;position:relative;background:#dcc6ad url("{{ asset_data('Holz-Hintergrund.png') }}") center/cover no-repeat;color:#17120f;width:210mm;min-height:297mm;padding:12mm 11mm 10mm;-webkit-box-decoration-break:clone;box-decoration-break:clone}
.menu-page:before{content:"";position:absolute;inset:0;background:rgba(245,229,208,.18);z-index:0;pointer-events:none}
.menu-page>*{position:relative;z-index:1}
.start-page{break-before:page}
.page-title{text-align:center;font-family:"Marker Felt","Segoe Print","Bradley Hand",cursive;font-size:19pt;font-weight:900;line-height:1;margin:0 0 3mm;text-transform:uppercase;letter-spacing:.02em}
.page-note{text-align:center;font-family:"Marker Felt","Segoe Print",cursive;font-size:8pt;font-weight:700;margin:-1mm 0 3.5mm}
.columns{max-width:186mm;margin:0 auto}
.category{break-inside:avoid;margin:0 0 4.4mm}
.category h2{font-family:"Marker Felt","Segoe Print","Bradley Hand",cursive;font-size:20pt;line-height:1.02;text-align:center;text-transform:uppercase;margin:0 0 1.5mm;font-weight:900;letter-spacing:.02em}
.category-desc{font-family:"Marker Felt","Segoe Print","Bradley Hand",cursive;text-align:center;font-size:7.2pt;font-weight:700;margin:0 0 1.4mm;line-height:1.1}
.item{break-inside:avoid;margin:0 0 1.25mm;padding:0 0 .7mm;border-bottom:.18mm solid rgba(89,58,39,.12)}
.item-main{display:grid;grid-template-columns:1fr auto;gap:2mm;align-items:baseline}
.item-name{font-family:"Marker Felt","Segoe Print","Bradley Hand",cursive;font-size:9.2pt;font-weight:900;text-transform:uppercase;line-height:1.02}
.item-number{display:inline-block;min-width:10mm}
.item-price{font-family:"Marker Felt","Segoe Print","Bradley Hand",cursive;font-size:9pt;font-weight:900;white-space:nowrap}
.item-desc{font-size:6.9pt;line-height:1.12;margin:.3mm 0 0 1.5mm}
.variant{display:flex;justify-content:space-between;gap:3mm;margin:.35mm 0 0 1.5mm;font-size:6.8pt;font-weight:700}.variant strong{white-space:nowrap}
.meta{font-size:5.9pt;margin:.35mm 0 0 1.5mm;font-weight:700;color:#4d3d32}
.burger-page .category{max-width:180mm;margin-left:auto;margin-right:auto}.burger-page .category h2{font-size:18pt}.burger-page .item{margin-bottom:1.8mm}.burger-page .item-main{grid-template-columns:56mm 1fr auto}.burger-page .item-name{font-size:10.5pt}.burger-page .item-desc{grid-column:2;margin:0;font-size:7.4pt}.burger-page .item-price{grid-column:3;grid-row:1}
.drinks-page .category h2,.cocktails-page .category h2{text-align:left;font-size:14pt}.drinks-page .item,.cocktails-page .item{margin-bottom:.8mm}.drinks-page .item-name,.drinks-page .item-price,.cocktails-page .item-name,.cocktails-page .item-price{font-size:8.3pt}.drinks-page .item-desc,.cocktails-page .item-desc{font-size:6.3pt}
.cocktails-page{page:cocktail-one;background:#dcc6ad url("{{ asset_data('Cocktail-1.png') }}") center/cover no-repeat}
.cocktails-page-two{page:cocktail-two;background:#dcc6ad url("{{ asset_data('Cocktail-2.png') }}") center/cover no-repeat}
.cocktails-page:before{background:transparent}
.cocktails-page .category:nth-child(4n+1) h2{color:#d46c31}.cocktails-page .category:nth-child(4n+2) h2{color:#668f31}.cocktails-page .category:nth-child(4n+3) h2{color:#d98924}.cocktails-page .category:nth-child(4n) h2{color:#6b9238}
.footer-note{break-inside:avoid;margin-top:5mm;text-align:center;font-family:"Marker Felt","Segoe Print",cursive;font-size:8pt;font-weight:800}
</style>
</head>
<body>

<section class="cover">{% if asset_data('original_cover.png') %}<img src="{{ asset_data('original_cover.png') }}" alt="TacoMex Speisen und Getränke">{% endif %}</section>

<!-- Essen: kompakt und auf Holz wie in der Originalkarte. -->
<section class="menu-page food-page start-page">
  <h1 class="page-title">Speisen</h1>
  <div class="columns">
  {% for category in categories %}
    {% if category.type.value == 'food' and 'burger' not in category.name|lower %}
    <section class="category">
      <h2>{{ category.name }}</h2>
      {% if category.description %}<p class="category-desc">{{ category.description }}</p>{% endif %}
      {% for item in category.items %}
      <article class="item">
        <div class="item-main"><span class="item-name">{% if item.order_number %}<span class="item-number">{{ item.order_number }}.</span>{% endif %}{{ item.name }}</span><span class="item-price">{{ format_price(item.price) }}</span></div>
        {% if item.description %}<p class="item-desc">{{ item.description }}</p>{% endif %}
        {% if item.second_price %}<div class="variant"><span>{{ item.second_price_label or 'Weitere Größe' }}</span><strong>{{ format_price(item.second_price) }}</strong></div>{% endif %}
        {% if item.allergens or item.additives %}<div class="meta">{% if item.allergens %}Allergene: {{ item.allergens }}{% endif %}{% if item.additives %}{% if item.allergens %} · {% endif %}Zusatzstoffe: {{ item.additives }}{% endif %}</div>{% endif %}
      </article>
      {% endfor %}
    </section>
    {% endif %}
  {% endfor %}
  </div>
</section>

<!-- Burger wie im Original als eigener Abschnitt / eigene Seite. -->
<section class="menu-page burger-page start-page">
  <h1 class="page-title">Burger-Karte</h1>
  <p class="page-note">Frische Produkte · hausgemachte Saucen · täglich frisch</p>
  <div class="columns">
  {% for category in categories %}{% if category.type.value == 'food' and 'burger' in category.name|lower %}
    <section class="category"><h2>{{ category.name }}</h2>{% if category.description %}<p class="category-desc">{{ category.description }}</p>{% endif %}
    {% for item in category.items %}<article class="item"><div class="item-main"><span class="item-name">{% if item.order_number %}<span class="item-number">{{ item.order_number }}.</span>{% endif %}{{ item.name }}</span>{% if item.description %}<span class="item-desc">{{ item.description }}</span>{% endif %}<span class="item-price">{{ format_price(item.price) }}</span></div>{% if item.second_price %}<div class="variant"><span>{{ item.second_price_label or 'Weitere Größe' }}</span><strong>{{ format_price(item.second_price) }}</strong></div>{% endif %}</article>{% endfor %}
    </section>
  {% endif %}{% endfor %}
  </div>
</section>

<!-- Getränke beginnen wie im Original auf einer neuen Seite. -->
<section class="menu-page drinks-page start-page">
  <h1 class="page-title">Getränke</h1>
  <div class="columns">
  {% for category in categories %}{% if category.type.value == 'drinks' %}
    <section class="category"><h2>{{ category.name }}</h2>{% if category.description %}<p class="category-desc">{{ category.description }}</p>{% endif %}
    {% for item in category.items %}<article class="item"><div class="item-main"><span class="item-name">{% if item.order_number %}<span class="item-number">{{ item.order_number }}.</span>{% endif %}{{ item.name }}</span><span class="item-price">{{ format_price(item.price) }}</span></div>{% if item.description %}<p class="item-desc">{{ item.description }}</p>{% endif %}{% if item.second_price %}<div class="variant"><span>{{ item.second_price_label or 'Weitere Größe' }}</span><strong>{{ format_price(item.second_price) }}</strong></div>{% endif %}</article>{% endfor %}
    </section>
  {% endif %}{% endfor %}
  </div>
</section>

<!-- Cocktails beginnen ebenfalls auf einer neuen Seite, mit farbigen handschriftlichen Rubriken wie im Original. -->
<section class="menu-page cocktails-page cocktails-page-one start-page">
  <h1 class="page-title">Cocktails</h1>
  <div class="columns">
  {% for category in cocktail_categories[:4] %}
    <section class="category"><h2>{{ category.name }}</h2>{% if category.description %}<p class="category-desc">{{ category.description }}</p>{% endif %}
    {% for item in category.items %}<article class="item"><div class="item-main"><span class="item-name">{% if item.order_number %}<span class="item-number">{{ item.order_number }}.</span>{% endif %}{{ item.name }}</span><span class="item-price">{{ format_price(item.price) }}</span></div>{% if item.description %}<p class="item-desc">{{ item.description }}</p>{% endif %}{% if item.second_price %}<div class="variant"><span>{{ item.second_price_label or 'Weitere Größe' }}</span><strong>{{ format_price(item.second_price) }}</strong></div>{% endif %}</article>{% endfor %}
    </section>
  {% endfor %}
  </div>
</section>

<section class="menu-page cocktails-page cocktails-page-two start-page">
  <div class="columns">
  {% for category in cocktail_categories[4:] %}
    <section class="category"><h2>{{ category.name }}</h2>{% if category.description %}<p class="category-desc">{{ category.description }}</p>{% endif %}
    {% for item in category.items %}<article class="item"><div class="item-main"><span class="item-name">{% if item.order_number %}<span class="item-number">{{ item.order_number }}.</span>{% endif %}{{ item.name }}</span><span class="item-price">{{ format_price(item.price) }}</span></div>{% if item.description %}<p class="item-desc">{{ item.description }}</p>{% endif %}{% if item.second_price %}<div class="variant"><span>{{ item.second_price_label or 'Weitere Größe' }}</span><strong>{{ format_price(item.second_price) }}</strong></div>{% endif %}</article>{% endfor %}
    </section>
  {% endfor %}
  </div>
  <div class="footer-note">* Keine Happy Hour</div>
</section>
</body>
</html>
